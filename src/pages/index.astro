---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import LineaTiempo from '../components/LineaTiempo.astro';
import TarjetaAviso from '../components/TarjetaAviso.astro';
import CarruselColegios from '../components/CarruselColegios.astro';
import sitio from '../data/sitio.json';
import testimonios from '../data/testimonios.json';
import { foto } from '../lib/fotos';

const fotoHero = foto('hero-banderas-cielo.jpg');

const avisos = (await getCollection('avisos'))
  .filter((a) => a.data.generacion !== 'Comunidad')
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
const recientes = avisos.slice(0, 3);
const generacionActual = sitio.convocatoria.generacion;
const etapa = sitio.convocatoria.etapaActual;
const nombreEtapa = sitio.etapas[etapa - 1]?.nombre;

const testimonio = testimonios[0];
const { afiliados, meta, anioAnterior, anioMeta } = sitio.afiliacion;
---

<Base
  titulo="Inicio"
  portada
  descripcion="UWC México selecciona a jóvenes mexicanos por su mérito y potencial para estudiar el Bachillerato Internacional en uno de los 18 Colegios del Mundo Unido, con becas según la necesidad de cada familia."
>
  <!-- ============ PORTADA ============ -->
  <section class="hero fondo-foto fondo-foto--degradado parallax">
    <div class="fondo-foto__img">
      <Image
        src={fotoHero}
        alt="Estudiantes UWC de decenas de países con las banderas de sus naciones bajo un cielo azul"
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="contenedor hero__interior">
      <h1>Tu aventura educativa por el mundo empieza aquí</h1>
      <p class="hero__entrada">
        Estudia el Bachillerato Internacional en uno de los 18 Colegios del Mundo Unido, con jóvenes de más de 150 países. Te
        seleccionamos por tu mérito y tu potencial, no por tu situación económica.
      </p>
      <div class="botones">
        <a href="/aplica/" class="boton boton--blanco">Conoce cómo aplicar <Icono nombre="flecha" tam={18} /></a>
        <a href="/descubre/" class="boton boton--contorno-blanco">Descubre UWC</a>
      </div>
    </div>
  </section>

  <!-- ============ AVISOS DEL PROCESO (lo primero para aspirantes) ============ -->
  <section class="avisos" aria-labelledby="t-avisos">
    <div class="contenedor avisos__caja">
      <div class="avisos__encabezado">
        <p class="avisos__estado">
          <span class="punto" aria-hidden="true"></span>
          Proceso {generacionActual}{nombreEtapa && ` · Etapa ${etapa}: ${nombreEtapa}`}
        </p>
        <h2 id="t-avisos">Avisos del proceso de selección</h2>
        <a href="/avisos/" class="enlace">Ver todos los avisos <Icono nombre="flecha" tam={18} /></a>
      </div>
      <ul class="avisos__lista">
        {recientes.map((a) => <li><TarjetaAviso aviso={a} compacta /></li>)}
      </ul>
    </div>
  </section>

  <!-- ============ QUÉ ES ============ -->
  <section class="seccion declaracion">
    <div class="contenedor declaracion__grid">
      <div class="revelar">
        <h2>Dos años de bachillerato que cambian la forma en que ves el mundo.</h2>
        <div class="botones">
          <a href="/descubre/" class="boton boton--contorno">Qué hace única a UWC</a>
          <a href="/descubre/colegios/" class="boton boton--contorno">Los 18 colegios</a>
        </div>
      </div>
      <div class="declaracion__texto revelar" style="--retraso:120ms">
        <p>
          Los Colegios del Mundo Unido (UWC) son un movimiento educativo global que reúne a jóvenes de todos los orígenes para
          vivir y estudiar juntos durante dos años. Su misión: <strong>hacer de la educación una fuerza para unir a las personas, las
          naciones y las culturas por la paz y un futuro sostenible.</strong>
        </p>
        <p>
          Desde 1977, <strong>UWC México</strong> selecciona cada año a jóvenes mexicanos para estudiar el{" "}
          <strong>Diploma del Bachillerato Internacional</strong>, reconocido por la SEP, la UNAM y universidades de todo el mundo.
        </p>
        <p>
          Más del 80% de los estudiantes UWC recibe apoyo financiero. En México, la beca se define según lo que cada familia puede
          aportar, para que el dinero nunca sea la razón por la que alguien no vaya.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ PROCESO (fondo con foto) ============ -->
  <section class="proceso fondo-foto parallax" aria-labelledby="t-proceso">
    <div class="fondo-foto__img">
      <Image src={foto('pasaportes.jpg')} alt="" widths={[800, 1400, 2000]} sizes="100vw" />
    </div>
    <div class="contenedor">
      <div class="proceso__encabezado">
        <div>
          <h2 id="t-proceso">¿Cómo te seleccionamos?</h2>
          <p>Cinco etapas entre abril y diciembre. Solo cuentan tu mérito y tu potencial.</p>
        </div>
        <div class="botones">
          <a href="/aplica/" class="boton boton--blanco">Requisitos y proceso <Icono nombre="flecha" tam={18} /></a>
        </div>
      </div>
      <LineaTiempo claro />
    </div>
  </section>

  <!-- ============ CIFRAS ============ -->
  <section class="cifras seccion--gris" aria-label="UWC en cifras">
    <div class="contenedor">
      <ul class="cifras__lista">
        {
          sitio.cifras.map((c, i) => (
            <li class="revelar" style={`--retraso:${i * 100}ms`}>
              <strong>{c.valor}</strong>
              <span>{c.etiqueta}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ COLEGIOS ============ -->
  <section class="seccion colegios" aria-labelledby="t-colegios">
    <div class="contenedor">
      <div class="colegios__encabezado">
        <h2 id="t-colegios">¿A dónde podrías ir?</h2>
        <p class="texto-grande">18 colegios en cuatro continentes. Cada uno con su propio carácter, todos con la misma misión.</p>
      </div>
      <CarruselColegios />
    </div>
  </section>

  <!-- ============ TESTIMONIO (fondo con foto) ============ -->
  <section class="testimonio fondo-foto parallax" aria-label="Testimonio de un graduado">
    <div class="fondo-foto__img">
      <Image src={foto('hero-amistad-uwc.jpg')} alt="" widths={[800, 1400]} sizes="100vw" />
    </div>
    <div class="contenedor">
      <figure class="revelar">
        <blockquote>
          <p>“{testimonio.cita}”</p>
        </blockquote>
        <figcaption>
          <strong>{testimonio.nombre}</strong>
          <span>{testimonio.colegio}</span>
        </figcaption>
      </figure>
      <a href="/comunidad/" class="enlace enlace--blanco">Más historias de nuestra comunidad <Icono nombre="flecha" tam={18} /></a>
    </div>
  </section>

  <!-- ============ DONAR ============ -->
  <section class="donar" aria-labelledby="t-donar">
    <div class="donar__foto">
      <Image src={foto('hero-graduacion-robert-bosch.jpg')} alt="Graduados latinoamericanos, varios de ellos mexicanos, celebran con sus diplomas" widths={[640, 1000, 1400]} sizes="(min-width: 960px) 50vw, 100vw" />
    </div>
    <div class="donar__texto">
      <h2 id="t-donar">Haz posible que más jóvenes mexicanos vivan UWC</h2>
      <p class="texto-grande">
        Un año en un Colegio del Mundo Unido cuesta en promedio 40,000 dólares. Graduados, familias, empresas y amigos hacen que
        ningún joven seleccionado se quede fuera por dinero.
      </p>
      <p>Somos donataria autorizada desde 1981: tu donativo es deducible de impuestos en México.</p>
      <div class="meta">
        <p><strong>{afiliados}</strong> afiliados en {anioAnterior} · meta {anioMeta}: <strong>{meta}</strong></p>
        <div class="meta__barra" role="progressbar" aria-valuemin="0" aria-valuemax={meta} aria-valuenow={afiliados} aria-label="Avance de la campaña de afiliación">
          <span style={`width:${Math.round((afiliados / meta) * 100)}%`}></span>
        </div>
      </div>
      <div class="botones">
        <a href="/apoya/como-donar/" class="boton boton--donar"><Icono nombre="corazon" tam={18} />Dona ahora</a>
        <a href="/apoya/afiliate/" class="boton boton--contorno">Afíliate</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Portada ---------- */
  .hero {
    display: flex;
    align-items: center;
    min-height: min(92vh, 820px);
    padding-block: calc(var(--alto-header) + 3rem) 9rem;
  }
  .hero h1 { max-width: 13ch; margin-bottom: 0.4em; }
  .hero__entrada {
    max-width: 50ch;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.92);
    margin-bottom: 2rem;
  }

  /* ---------- Avisos ---------- */
  .avisos { position: relative; z-index: 2; margin-top: -6rem; }
  .avisos__caja {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--blanco);
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    border-top: 4px solid var(--verde);
  }
  @media (min-width: 1000px) {
    .avisos__caja { grid-template-columns: 250px 1fr; align-items: center; padding: 1.75rem 2rem; gap: 2rem; }
  }
  .avisos__estado {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--verde-texto);
  }
  .punto {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--verde);
    animation: latido 2s infinite;
  }
  @keyframes latido {
    0% { box-shadow: 0 0 0 0 rgb(0 148 130 / 0.6); }
    70% { box-shadow: 0 0 0 9px rgb(0 148 130 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(0 148 130 / 0); }
  }
  .avisos h2 { font-size: 1.6rem; margin-bottom: 0.5rem; }
  .avisos__lista {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 1fr);
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0 0 0.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .avisos__lista li { scroll-snap-align: start; }
  .avisos__lista :global(.aviso) { border: 1px solid var(--gris-linea); box-shadow: none; }

  /* ---------- Declaración ---------- */
  .declaracion__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 960px) { .declaracion__grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }
  .declaracion h2 { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem); }
  .declaracion .botones { margin-top: 2rem; }
  .declaracion__texto { font-size: 1.125rem; color: var(--texto-suave); }
  .declaracion__texto strong { color: var(--texto); }

  /* ---------- Proceso ---------- */
  .proceso { padding-block: clamp(4.5rem, 3rem + 5vw, 8rem); }
  .proceso::before { background: linear-gradient(180deg, rgb(0 58 120 / 0.9), rgb(10 31 61 / 0.92)); }
  .proceso__encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }
  .proceso__encabezado p { margin: 0; font-size: 1.2rem; color: rgb(255 255 255 / 0.85); }

  /* ---------- Cifras ---------- */
  .cifras { padding-block: 4.5rem; }
  .cifras__lista { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 1.5rem; list-style: none; margin: 0; padding: 0; text-align: center; }
  @media (min-width: 900px) { .cifras__lista { grid-template-columns: repeat(4, 1fr); } }
  .cifras strong { display: block; font-size: clamp(2.6rem, 2rem + 2.5vw, 4rem); line-height: 1; color: var(--azul); margin-bottom: 0.6rem; }
  .cifras span { color: var(--texto-suave); }

  /* ---------- Colegios ---------- */
  .colegios__encabezado { max-width: 720px; margin-bottom: 2.5rem; }

  /* ---------- Testimonio ---------- */
  .testimonio { padding-block: clamp(5rem, 4rem + 6vw, 10rem); text-align: center; }
  .testimonio::before { background: rgb(10 31 61 / 0.72); }
  .testimonio figure { max-width: 900px; margin: 0 auto 2rem; }
  .testimonio blockquote { margin: 0; }
  .testimonio blockquote p {
    font-family: var(--font-cita);
    font-style: italic;
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.3rem);
    line-height: 1.35;
  }
  .testimonio figcaption { display: grid; gap: 0.2rem; }
  .testimonio figcaption span { color: rgb(255 255 255 / 0.8); }
  .enlace--blanco { color: var(--blanco); }
  .enlace--blanco:hover { color: #9fe3d8; }

  /* ---------- Donar ---------- */
  .donar { display: grid; background: var(--gris-fondo); }
  @media (min-width: 960px) { .donar { grid-template-columns: 1fr 1fr; } }
  .donar__foto { min-height: 320px; }
  .donar__foto img { width: 100%; height: 100%; object-fit: cover; }
  .donar__texto { padding: clamp(3rem, 2rem + 4vw, 6rem) clamp(1.25rem, 1rem + 4vw, 6rem); align-self: center; max-width: 720px; }
  .meta { margin: 1.5rem 0 2rem; }
  .meta p { margin-bottom: 0.6rem; }
  .meta strong { color: var(--azul); font-size: 1.2rem; }
  .meta__barra { height: 10px; background: var(--gris-linea); border-radius: 5px; overflow: hidden; }
  .meta__barra span { display: block; height: 100%; background: var(--naranja); }
</style>
