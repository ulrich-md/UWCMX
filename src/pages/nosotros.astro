---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Icono from '../components/Icono.astro';
import sitio from '../data/sitio.json';
import documentos from '../data/documentos.json';

import fotoBecarios from '../assets/fotos/becarios.jpg';

const categorias = [...new Set(documentos.map((d) => d.categoria))];

const hitos = [
  { anio: '1962', texto: 'Abre UWC Atlantic, en Gales, el primer Colegio del Mundo Unido.' },
  { anio: '1977', texto: 'Se funda UWC México el 12 de julio, bajo la guía de Leonardo Mayer.' },
  { anio: '1981', texto: 'La Asociación es reconocida como donataria autorizada, sin interrupción hasta hoy.' },
  { anio: 'Hoy', texto: 'Cientos de graduados mexicanos y una convocatoria anual con más de 400 aspirantes.' },
];

const contactos = [
  { icono: 'correo', titulo: 'Información general', correo: sitio.contacto.correo },
  { icono: 'escudo', titulo: 'Quejas y sugerencias', correo: sitio.contacto.quejas },
  { icono: 'personas', titulo: 'Presidencia de la Asociación', correo: sitio.contacto.presidencia },
  { icono: 'documento', titulo: 'Tesorería y facturas', correo: sitio.contacto.tesoreria },
] as const;
---

<Base
  titulo="Nosotros"
  descripcion="UWC México es la Asociación Mexicana pro Colegios del Mundo Unido, A.C.: historia, organización, transparencia y contacto."
>
  <CabeceraPagina
    antetitulo="Nosotros"
    titulo="Graduados que abren la puerta a la siguiente generación"
    entrada="UWC México, cuyo nombre formal es Asociación Mexicana pro Colegios del Mundo Unido, A.C., representa en México al movimiento internacional UWC. Promovemos sus valores, seleccionamos a jóvenes mexicanos y reunimos fondos para becarlos."
    imagen={fotoBecarios}
    alt="Becarios de UWC México reunidos antes de partir a sus colegios"
  />

  <section class="seccion seccion--blanca">
    <div class="contenedor grid grid--3">
      <div class="tarjeta revelar">
        <span class="icono-circulo"><Icono nombre="mundo" /></span>
        <h3>Promovemos</h3>
        <p>Los valores UWC en México: educación para la paz, la diversidad y un futuro sostenible.</p>
      </div>
      <div class="tarjeta revelar" style="--retraso:80ms">
        <span class="icono-circulo icono-circulo--verde"><Icono nombre="birrete" /></span>
        <h3>Seleccionamos</h3>
        <p>Cada año, a los jóvenes mexicanos con mayor mérito y potencial, en un proceso de seis a ocho meses.</p>
      </div>
      <div class="tarjeta revelar" style="--retraso:160ms">
        <span class="icono-circulo icono-circulo--rosa"><Icono nombre="corazon" /></span>
        <h3>Becamos</h3>
        <p>Con fondos de graduados, empresas, amigos y las aportaciones de las familias, según la necesidad de cada una.</p>
      </div>
    </div>
  </section>

  <section id="historia" class="seccion">
    <div class="contenedor historia">
      <div>
        <p class="antetitulo">Historia</p>
        <h2>Casi 50 años de historia</h2>
        <p class="entrada">
          Sus fundadores fueron Leonardo Mayer, Carlos Alberto León, Roberto Mayer, David Morgan Phillips, Marco Aurelio Provencio
          Galván y Víctor Urquidi. Hoy la Asociación la forman, en su mayoría, graduados de los colegios que trabajan como
          voluntarios.
        </p>
      </div>
      <ol class="hitos">
        {
          hitos.map((h, i) => (
            <li class="revelar" style={`--retraso:${i * 90}ms`}>
              <span class="hitos__anio">{h.anio}</span>
              <p>{h.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="transparencia" class="seccion seccion--blanca">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <p class="antetitulo">Transparencia</p>
        <h2>Documentos públicos</h2>
        <p class="entrada">Estados financieros, informes anuales y las políticas que protegen a participantes, familias y donantes.</p>
      </div>
      <div class="grid grid--2">
        {
          categorias.map((cat) => (
            <div>
              <h3 class="docs__titulo">{cat}</h3>
              <ul class="docs">
                {documentos
                  .filter((d) => d.categoria === cat)
                  .map((d) => (
                    <li>
                      <a href={d.url}>
                        <Icono nombre="documento" />
                        <span>{d.titulo}</span>
                        <span class="docs__tipo">PDF</span>
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contacto" class="seccion">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <p class="antetitulo">Contacto</p>
        <h2>Escríbenos</h2>
        <p class="entrada">{sitio.contacto.horario} · {sitio.contacto.direccion}</p>
      </div>
      <div class="grid grid--4">
        {
          contactos.map((c) => (
            <a href={`mailto:${c.correo}`} class="tarjeta contacto">
              <span class="icono-circulo"><Icono nombre={c.icono} /></span>
              <h3>{c.titulo}</h3>
              <p>{c.correo}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .historia { display: grid; gap: var(--space-5); }
  @media (min-width: 1000px) { .historia { grid-template-columns: 1fr 1fr; gap: var(--space-6); } }
  .hitos { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--linea); }
  .hitos li { position: relative; padding: 0 0 var(--space-4) var(--space-4); }
  .hitos li::before {
    content: '';
    position: absolute;
    left: -9px;
    top: 0.4rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--papel);
    border: 3px solid var(--verde);
  }
  .hitos__anio { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 700; color: var(--azul); }
  .hitos p { margin: 0.2rem 0 0; color: var(--tinta-suave); }

  .docs__titulo { font-size: 1.3rem; }
  .docs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .docs a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 56px;
    padding: 0.8rem 1rem;
    border-radius: var(--radio-sm);
    border: 1px solid var(--linea);
    background: var(--papel);
    color: var(--tinta);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .docs a:hover { border-color: var(--azul); background: var(--azul-claro); color: var(--azul); }
  .docs svg { flex-shrink: 0; color: var(--azul); }
  .docs__tipo {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--blanco);
    border: 1px solid var(--linea);
    color: var(--tinta-suave);
  }
  .contacto p { overflow-wrap: anywhere; font-weight: 600; color: var(--azul) !important; }
</style>
