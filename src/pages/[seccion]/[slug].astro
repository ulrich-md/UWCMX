---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PortadaPagina from '../../components/PortadaPagina.astro';
import Icono from '../../components/Icono.astro';
import { SECCIONES, enlacesDeSeccion, type Seccion } from '../../lib/secciones';
import { foto } from '../../lib/fotos';

export async function getStaticPaths() {
  const paginas = await getCollection('paginas');
  return paginas.map((pagina) => {
    const [seccion, slug] = pagina.id.split('/');
    return { params: { seccion, slug }, props: { pagina } };
  });
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);
const seccion = pagina.data.seccion as Seccion;
const infoSeccion = SECCIONES[seccion];
const enlaces = await enlacesDeSeccion(seccion);
const aqui = `/${pagina.id}/`;
const indice = enlaces.findIndex((e) => e.href === aqui);
const siguiente = indice >= 0 ? enlaces[indice + 1] : undefined;
const imagen = foto(pagina.data.imagen ?? infoSeccion.foto);
---

<Base titulo={pagina.data.titulo} descripcion={pagina.data.resumen} portada>
  <PortadaPagina
    titulo={pagina.data.titulo}
    entrada={pagina.data.resumen}
    imagen={imagen}
    migas={[{ texto: infoSeccion.titulo, href: `/${seccion}/` }]}
  />

  <div class="contenedor pagina">
    <aside class="pagina__lateral" aria-label={`Más en ${infoSeccion.titulo}`}>
      <details class="submenu" open>
        <summary>
          <span>{infoSeccion.titulo}</span>
          <Icono nombre="abajo" tam={18} />
        </summary>
        <ul>
          <li><a href={`/${seccion}/`}>Inicio de {infoSeccion.titulo}</a></li>
          {
            enlaces.map((e) => (
              <li>
                <a href={e.href} aria-current={e.href === aqui ? 'page' : undefined}>
                  {e.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </aside>

    <article class="pagina__contenido">
      <div class="prosa">
        <Content />
      </div>

      {
        siguiente && (
          <a href={siguiente.href} class="siguiente">
            <span>Siguiente</span>
            <strong>{siguiente.texto}</strong>
            <Icono nombre="flecha" tam={24} />
          </a>
        )
      }
    </article>
  </div>
</Base>

<style>
  .pagina {
    display: grid;
    gap: 2.5rem;
    padding-block: 3.5rem 5rem;
  }
  @media (min-width: 1000px) {
    .pagina { grid-template-columns: 280px minmax(0, 1fr); gap: 4.5rem; padding-block: 4.5rem 6rem; }
  }
  .pagina__contenido { max-width: 760px; }

  .pagina__lateral { align-self: start; }
  @media (min-width: 1000px) { .pagina__lateral { position: sticky; top: calc(var(--alto-header) + 1.5rem); } }
  .submenu { border-top: 4px solid var(--verde); background: var(--gris-fondo); border-radius: 0 0 var(--radio) var(--radio); }
  .submenu summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--azul);
    cursor: pointer;
    list-style: none;
  }
  .submenu summary::-webkit-details-marker { display: none; }
  .submenu summary :global(svg) { transition: transform 0.25s var(--ease); }
  .submenu[open] summary :global(svg) { transform: rotate(180deg); }
  @media (min-width: 1000px) {
    .submenu summary { pointer-events: none; }
    .submenu summary :global(svg) { display: none; }
  }
  .submenu ul { list-style: none; margin: 0; padding: 0 0.75rem 1rem; }
  .submenu a {
    display: block;
    padding: 0.55rem 0.6rem;
    border-left: 3px solid transparent;
    color: var(--texto);
    text-decoration: none;
    font-size: 0.975rem;
    line-height: 1.35;
  }
  .submenu a:hover { color: var(--azul); background: var(--blanco); }
  .submenu a[aria-current='page'] { border-left-color: var(--verde); color: var(--azul); font-weight: 700; background: var(--blanco); }

  .siguiente {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.2rem 1rem;
    margin-top: 4rem;
    padding: 1.5rem 1.75rem;
    background: var(--degradado);
    color: var(--blanco);
    border-radius: var(--radio);
    text-decoration: none;
  }
  .siguiente:hover { color: var(--blanco); }
  .siguiente span { font-size: 0.875rem; font-weight: 600; opacity: 0.85; grid-column: 1; }
  .siguiente strong { font-size: 1.35rem; grid-column: 1; }
  .siguiente :global(svg) { grid-column: 2; grid-row: 1 / 3; transition: transform 0.25s var(--ease); }
  .siguiente:hover :global(svg) { transform: translateX(5px); }
</style>
