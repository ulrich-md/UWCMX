---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PortadaPagina from '../../components/PortadaPagina.astro';
import TarjetaAviso from '../../components/TarjetaAviso.astro';
import Icono from '../../components/Icono.astro';
import sitio from '../../data/sitio.json';
import { foto } from '../../lib/fotos';

const avisos = (await getCollection('avisos')).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

// Agrupar por generación; la generación actual primero y "Comunidad" al final.
const grupos = new Map<string, typeof avisos>();
for (const a of avisos) {
  const lista = grupos.get(a.data.generacion) ?? [];
  lista.push(a);
  grupos.set(a.data.generacion, lista);
}
const generaciones = [...grupos.keys()].sort((a, b) => {
  if (a === 'Comunidad') return 1;
  if (b === 'Comunidad') return -1;
  return b.localeCompare(a);
});
const actual = sitio.convocatoria.generacion;
const id = (g: string) => `g-${g.replace(/[^0-9a-zA-Z]+/g, '-')}`;
---

<Base titulo="Avisos del proceso" portada descripcion="Avisos oficiales del proceso de selección de UWC México: resultados, fechas e indicaciones de cada etapa, por generación.">
  <PortadaPagina
    titulo="Avisos del proceso de selección"
    entrada="Aquí publicamos los resultados, las fechas y las indicaciones de cada etapa. Revísalos con frecuencia: quien pierde una fecha queda fuera del proceso."
    imagen={foto('seccion-cuestionario.jpg')}
    migas={[{ texto: 'Aplica', href: '/aplica/' }]}
  />

  <nav class="filtro" aria-label="Generaciones">
    <div class="contenedor">
      <ul>
        {generaciones.map((g) => <li><a href={`#${id(g)}`}>{g === 'Comunidad' ? 'Asociación' : `Generación ${g}`}</a></li>)}
      </ul>
    </div>
  </nav>

  {
    generaciones.map((g) => {
      const lista = grupos.get(g)!;
      const esActual = g === actual;
      return (
        <section id={id(g)} class:list={['grupo', { 'grupo--actual': esActual }]}>
          <div class="contenedor">
            <div class="grupo__encabezado">
              <h2>{g === 'Comunidad' ? 'Avisos de la Asociación' : `Generación ${g}`}</h2>
              <span>
                {lista.length} avisos{esActual && ' · proceso en curso'}
              </span>
            </div>
            {esActual ? (
              <ul class="grupo__lista">
                {lista.map((a) => (
                  <li>
                    <TarjetaAviso aviso={a} />
                  </li>
                ))}
              </ul>
            ) : (
              <details class="grupo__archivo">
                <summary>
                  Ver los {lista.length} avisos de {g === 'Comunidad' ? 'la Asociación' : `la generación ${g}`}
                  <Icono nombre="abajo" tam={20} />
                </summary>
                <ul class="grupo__lista">
                  {lista.map((a) => (
                    <li>
                      <TarjetaAviso aviso={a} />
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .filtro { position: sticky; top: var(--alto-header); z-index: 20; background: var(--blanco); border-bottom: 1px solid var(--gris-linea); }
  .filtro ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0.5rem 0; overflow-x: auto; }
  .filtro a { display: block; padding: 0.6rem 1rem; white-space: nowrap; font-weight: 600; color: var(--texto); text-decoration: none; border-radius: var(--radio); }
  .filtro a:hover { background: var(--gris-fondo); color: var(--azul); }

  .grupo { padding-block: 3.5rem; border-bottom: 1px solid var(--gris-linea); }
  .grupo--actual { background: var(--gris-fondo); padding-block: 4rem 5rem; }
  .grupo__encabezado { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.25rem; margin-bottom: 2rem; }
  .grupo__encabezado h2 { margin: 0; font-size: clamp(1.7rem, 1.4rem + 1vw, 2.3rem); }
  .grupo__encabezado span { font-weight: 600; color: var(--verde-texto); }
  .grupo__lista { display: grid; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  @media (min-width: 700px) { .grupo__lista { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grupo__lista { grid-template-columns: repeat(3, 1fr); } }
  .grupo__archivo summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.6rem 1.2rem;
    border: 2px solid var(--azul);
    border-radius: var(--radio);
    font-weight: 700;
    color: var(--azul);
    cursor: pointer;
    list-style: none;
  }
  .grupo__archivo summary::-webkit-details-marker { display: none; }
  .grupo__archivo summary :global(svg) { transition: transform 0.25s var(--ease); }
  .grupo__archivo[open] summary { margin-bottom: 2rem; }
  .grupo__archivo[open] summary :global(svg) { transform: rotate(180deg); }
</style>
