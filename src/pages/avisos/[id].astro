---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import sitio from '../../data/sitio.json';

export async function getStaticPaths() {
  const avisos = await getCollection('avisos');
  return avisos.map((aviso) => ({ params: { id: aviso.id }, props: { aviso } }));
}

const { aviso } = Astro.props;
const { Content } = await render(aviso);
const fecha = aviso.data.fecha.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base titulo={aviso.data.titulo} descripcion={aviso.data.resumen}>
  <article class="aviso">
    <div class="contenedor aviso__grid">
      <div>
        <a href="/avisos/" class="enlace-flecha volver"><Icono nombre="flecha" tam={18} class="girar" />Todos los avisos</a>
        <p class="aviso__meta">
          <span>{aviso.data.etapa}</span>
          <span aria-hidden="true">·</span>
          <time datetime={aviso.data.fecha.toISOString().slice(0, 10)}>{fecha}</time>
        </p>
        <h1>{aviso.data.titulo}</h1>
        <p class="entrada">{aviso.data.resumen}</p>
        <div class="prosa">
          <Content />
        </div>
        {
          aviso.data.enlace && (
            <a href={aviso.data.enlace.url} class="boton boton--primario">
              {aviso.data.enlace.texto} <Icono nombre="externo" tam={18} />
            </a>
          )
        }
      </div>

      <aside class="aviso__lateral">
        <div class="tarjeta">
          <span class="icono-circulo"><Icono nombre="correo" /></span>
          <h2>¿Tienes dudas?</h2>
          <p>Escríbenos y te respondemos en horario de oficina.</p>
          <a href={`mailto:${sitio.contacto.correo}`}>{sitio.contacto.correo}</a>
          <p class="aviso__horario">{sitio.contacto.horario}</p>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .aviso { padding-block: var(--space-5) var(--space-6); }
  .aviso__grid {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 1000px) {
    .aviso__grid { grid-template-columns: minmax(0, 1fr) 320px; gap: var(--space-6); }
  }
  .aviso h1 { font-size: clamp(2rem, 1.5rem + 2vw, 3rem); max-width: 22ch; }
  .volver { margin-bottom: var(--space-4); }
  .volver :global(.girar) { transform: rotate(180deg); }
  .volver:hover :global(.girar) { transform: rotate(180deg) translateX(4px); }
  .aviso__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--verde-texto);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .aviso .entrada { margin-bottom: var(--space-4); padding-bottom: var(--space-4); border-bottom: 1px solid var(--linea); }
  .aviso .boton { margin-top: var(--space-3); }
  .aviso__lateral .tarjeta { position: sticky; top: 100px; }
  .aviso__lateral h2 { font-size: 1.35rem; margin: 0; }
  .aviso__lateral a { font-weight: 700; word-break: break-all; }
  .aviso__horario { font-size: var(--text-sm); }
</style>
