---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import sitio from '../../data/sitio.json';
import { banner } from '../../lib/fotos';

export async function getStaticPaths() {
  const avisos = await getCollection('avisos');
  return avisos.map((aviso) => ({ params: { id: aviso.id }, props: { aviso, todos: avisos } }));
}

const { aviso, todos } = Astro.props;
const { Content } = await render(aviso);
const img = banner(aviso.data.imagen);
const fecha = aviso.data.fecha.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const hermanos = todos
  .filter((a) => a.data.generacion === aviso.data.generacion)
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
---

<Base titulo={aviso.data.titulo} descripcion={aviso.data.resumen}>
  <header class="cabecera">
    <div class="contenedor">
      <nav aria-label="Ruta de navegación" class="migas">
        <a href="/aplica/">Aplica</a>
        <Icono nombre="derecha" tam={14} />
        <a href="/avisos/">Avisos</a>
        <Icono nombre="derecha" tam={14} />
        <span>{aviso.data.generacion === 'Comunidad' ? 'Asociación' : `Generación ${aviso.data.generacion}`}</span>
      </nav>
      <p class="cabecera__meta">
        <time datetime={aviso.data.fecha.toISOString().slice(0, 10)}>{fecha}</time>
        {aviso.data.etapa && <span>{aviso.data.etapa}</span>}
      </p>
      <h1>{aviso.data.titulo}</h1>
    </div>
  </header>

  <div class="contenedor aviso">
    <article>
      {
        img && (
          <Image src={img} alt={`Banner: ${aviso.data.titulo}`} widths={[640, 960, 1200]} sizes="(min-width: 1000px) 780px, 92vw" class="aviso__banner" loading="eager" />
        )
      }
      <p class="aviso__resumen">{aviso.data.resumen}</p>
      <div class="prosa">
        <Content />
      </div>
      {
        aviso.data.enlace && (
          <a href={aviso.data.enlace.url} class="boton boton--azul aviso__enlace">
            {aviso.data.enlace.texto} <Icono nombre="externo" tam={18} />
          </a>
        )
      }
    </article>

    <aside class="lateral">
      <div class="lateral__caja lateral__caja--dudas">
        <h2>¿Tienes dudas?</h2>
        <p>Escríbenos, {sitio.contacto.horario.toLowerCase()}.</p>
        <a href={`mailto:${sitio.contacto.correo}`} class="boton boton--azul"><Icono nombre="correo" tam={18} />{sitio.contacto.correo}</a>
      </div>
      {
        hermanos.length > 1 && (
          <div class="lateral__caja">
            <h2>Otros avisos de esta generación</h2>
            <ul>
              {hermanos.map((h) => (
                <li>
                  <a href={`/avisos/${h.id}/`} aria-current={h.id === aviso.id ? 'page' : undefined}>
                    {h.data.titulo}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>
</Base>

<style>
  .cabecera { background: var(--degradado); color: var(--blanco); padding-block: 3rem; }
  .cabecera h1 { font-size: clamp(2rem, 1.4rem + 2.5vw, 3.4rem); max-width: 24ch; margin: 0; }
  .migas { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin-bottom: 1.5rem; font-size: 0.9rem; font-weight: 600; }
  .migas a { color: rgb(255 255 255 / 0.85); text-decoration: none; }
  .migas a:hover { color: var(--blanco); text-decoration: underline; }
  .migas :global(svg) { opacity: 0.6; }
  .migas span { color: rgb(255 255 255 / 0.7); }
  .cabecera__meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-bottom: 0.75rem; font-weight: 700; color: #9fe3d8; }
  .cabecera__meta span::before { content: '· '; }

  .aviso { display: grid; gap: 3rem; padding-block: 3rem 5rem; }
  @media (min-width: 1000px) { .aviso { grid-template-columns: minmax(0, 780px) 1fr; gap: 4rem; } }
  .aviso__banner { width: 100%; border-radius: var(--radio); box-shadow: var(--sombra); margin-bottom: 2rem; }
  .aviso__resumen { font-size: 1.3rem; line-height: 1.5; font-weight: 600; color: var(--azul-noche); padding-bottom: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--gris-linea); }
  .aviso__enlace { margin-top: 1.5rem; }

  .lateral { display: grid; gap: 1.5rem; align-content: start; }
  @media (min-width: 1000px) { .lateral { position: sticky; top: calc(var(--alto-header) + 1.5rem); align-self: start; } }
  .lateral__caja { padding: 1.5rem; background: var(--gris-fondo); border-top: 4px solid var(--verde); border-radius: 0 0 var(--radio) var(--radio); }
  .lateral__caja h2 { font-size: 1.2rem; margin-bottom: 0.75rem; }
  .lateral__caja--dudas .boton { width: 100%; font-size: 0.95rem; overflow-wrap: anywhere; }
  .lateral__caja ul { list-style: none; margin: 0; padding: 0; }
  .lateral__caja li a { display: block; padding: 0.55rem 0; border-bottom: 1px solid var(--gris-linea); color: var(--texto); text-decoration: none; font-size: 0.95rem; line-height: 1.35; }
  .lateral__caja li a:hover { color: var(--azul); }
  .lateral__caja li a[aria-current='page'] { color: var(--azul); font-weight: 700; }
</style>
