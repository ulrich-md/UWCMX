---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Icono from '../components/Icono.astro';
import sitio from '../data/sitio.json';
import testimonios from '../data/testimonios.json';

import fotoCampamento from '../assets/fotos/campamento.jpg';
import fotoGraduados from '../assets/fotos/graduados.jpg';
---

<Base
  titulo="Comunidad"
  descripcion="La comunidad de graduados, becarios y afiliados de UWC México: historias, red de graduados y cómo participar."
>
  <CabeceraPagina
    antetitulo="Comunidad"
    titulo="Una red que empezó en 1964 y sigue creciendo"
    entrada="Graduados, becarios, familias y amigos que siguen conectados con UWC mucho después de terminar el colegio. Muchos regresan como voluntarios para entrevistar, evaluar y acompañar a la siguiente generación."
    imagen={fotoCampamento}
    alt="Graduados y becarios de UWC México en un campamento, sonriendo al aire libre"
  />

  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <p class="antetitulo">Historias</p>
        <h2>En sus propias palabras</h2>
      </div>
      <div class="grid grid--3">
        {
          testimonios.map((t, i) => (
            <figure class="tarjeta testimonio revelar" style={`--retraso:${i * 80}ms`}>
              <span class="testimonio__comillas" aria-hidden="true">“</span>
              <blockquote>
                <p>{t.cita}</p>
              </blockquote>
              <figcaption>
                <strong>{t.nombre}</strong>
                <span>{t.colegio}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="comparte">
        ¿Eres graduado? Comparte tu historia escribiendo a <a href={`mailto:${sitio.contacto.correo}`}>{sitio.contacto.correo}</a>.
      </p>
    </div>
  </section>

  <section id="graduados" class="seccion">
    <div class="contenedor red">
      <div class="red__foto revelar">
        <Image src={fotoGraduados} alt="Tres graduados de UWC México con sus bandas de graduación" widths={[480, 720]} sizes="(min-width: 1000px) 480px, 92vw" />
      </div>
      <div>
        <p class="antetitulo">Red de graduados</p>
        <h2>Si fuiste a un UWC, esta sigue siendo tu casa</h2>
        <ul class="acciones">
          <li>
            <span class="icono-circulo"><Icono nombre="documento" /></span>
            <div>
              <h3>Actualiza tus datos</h3>
              <p>Queremos saber dónde estás para invitarte a eventos y a colaborar en la selección.</p>
            </div>
          </li>
          <li>
            <span class="icono-circulo icono-circulo--verde"><Icono nombre="birrete" /></span>
            <div>
              <h3>Sé voluntario en la selección</h3>
              <p>Graduados como tú evalúan cuestionarios y entrevistan a aspirantes cada año.</p>
            </div>
          </li>
          <li>
            <span class="icono-circulo icono-circulo--rosa"><Icono nombre="corazon" /></span>
            <div>
              <h3>Afíliate a la Asociación</h3>
              <p>Con tu cuota anual haces posible que más jóvenes tengan la misma oportunidad que tú.</p>
            </div>
          </li>
        </ul>
        <div class="botones">
          <a href={`mailto:${sitio.contacto.correo}?subject=Actualizar%20mis%20datos%20de%20graduado`} class="boton boton--primario">Actualizar mis datos</a>
          <a href="/apoya/#afiliate" class="boton boton--contorno">Afíliate</a>
        </div>
      </div>
    </div>
  </section>

  <section id="afiliados" class="seccion seccion--oscura">
    <div class="contenedor afiliados">
      <Icono nombre="estrella" tam={36} />
      <h2>Gracias a nuestros {sitio.afiliacion.afiliados} afiliados de {sitio.afiliacion.anioAnterior}</h2>
      <p class="entrada">
        Cada estrella en nuestro cuadro de honor es una persona que retribuye lo que recibió. En {sitio.afiliacion.anioMeta} queremos
        llegar a {sitio.afiliacion.meta}.
      </p>
      <a href="/apoya/#afiliate" class="boton boton--claro">Quiero sumarme <Icono nombre="flecha" tam={18} /></a>
    </div>
  </section>
</Base>

<style>
  .testimonio { margin: 0; gap: var(--space-2); }
  .testimonio__comillas {
    font-family: var(--font-serif);
    font-size: 4.5rem;
    line-height: 0.5;
    height: 2rem;
    color: var(--verde);
  }
  .testimonio blockquote { margin: 0; }
  .testimonio blockquote p {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--azul-profundo) !important;
  }
  .testimonio figcaption { display: grid; margin-top: auto; padding-top: var(--space-2); border-top: 1px solid var(--linea); }
  .testimonio figcaption span { font-size: var(--text-sm); color: var(--tinta-suave); }
  .comparte { margin-top: var(--space-4); text-align: center; color: var(--tinta-suave); }

  .red { display: grid; gap: var(--space-5); align-items: center; }
  @media (min-width: 1000px) { .red { grid-template-columns: 0.9fr 1.1fr; gap: var(--space-6); } }
  .red__foto { aspect-ratio: 4/5; border-radius: 999px 999px var(--radio) var(--radio); overflow: hidden; box-shadow: var(--sombra-alta); max-width: 460px; }
  .red__foto img { width: 100%; height: 100%; object-fit: cover; }
  .acciones { list-style: none; margin: var(--space-3) 0 var(--space-4); padding: 0; display: grid; gap: var(--space-3); }
  .acciones li { display: flex; gap: var(--space-2); align-items: flex-start; }
  .acciones .icono-circulo { flex-shrink: 0; margin: 0; }
  .acciones h3 { font-size: 1.2rem; margin-bottom: 0.2rem; }
  .acciones p { margin: 0; color: var(--tinta-suave); }

  .afiliados { display: grid; justify-items: center; text-align: center; }
  .afiliados > svg { color: var(--sol); margin-bottom: var(--space-2); }
  .afiliados .entrada { margin-inline: auto; margin-bottom: var(--space-3); }
</style>
