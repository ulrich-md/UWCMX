---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PortadaPagina from '../../components/PortadaPagina.astro';
import TarjetasSeccion from '../../components/TarjetasSeccion.astro';
import Icono from '../../components/Icono.astro';
import testimonios from '../../data/testimonios.json';
import sitio from '../../data/sitio.json';
import { foto } from '../../lib/fotos';
---

<Base titulo="Comunidad" portada descripcion="La comunidad de graduados, becarios y afiliados de UWC México: historias, generaciones y red de graduados.">
  <PortadaPagina
    titulo="Una comunidad que no se termina al graduarte"
    entrada="Graduados, becarios, familias y amigos que siguen conectados con UWC. Muchos regresan como voluntarios para seleccionar y acompañar a la siguiente generación."
    imagen={foto('seccion-comunidad-voluntarios.jpg')}
    alt="Graduados y voluntarios de UWC México reunidos en un jardín"
    migas={[{ texto: 'Comunidad', href: '/comunidad/' }]}
    alta
  />

  <section class="seccion">
    <div class="contenedor">
      <div class="encabezado"><h2>En sus propias palabras</h2></div>
      <div class="citas">
        {
          testimonios.map((t, i) => (
            <figure class="revelar" style={`--retraso:${i * 100}ms`}>
              <blockquote><p>“{t.cita}”</p></blockquote>
              <figcaption>
                <strong>{t.nombre}</strong>
                <span>{t.colegio}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="comparte">¿Eres graduado? Comparte tu historia en <a href={`mailto:${sitio.contacto.correo}`}>{sitio.contacto.correo}</a>.</p>
    </div>
  </section>

  <section class="franja fondo-foto parallax">
    <div class="fondo-foto__img"><Image src={foto('seccion-trajes-tipicos.jpg')} alt="" widths={[800, 1400]} sizes="100vw" /></div>
    <div class="contenedor franja__interior">
      <h2>Si fuiste a un UWC, esta sigue siendo tu casa</h2>
      <p>Actualiza tus datos, participa como voluntario en la selección y afíliate a la Asociación.</p>
      <div class="botones">
        <a href="/comunidad/red-de-graduados/" class="boton boton--blanco">Red de graduados <Icono nombre="flecha" tam={18} /></a>
        <a href="/apoya/afiliate/" class="boton boton--contorno-blanco">Afíliate</a>
      </div>
    </div>
  </section>

  <section class="seccion seccion--gris">
    <div class="contenedor">
      <div class="encabezado"><h2>Explora la comunidad</h2></div>
      <TarjetasSeccion seccion="comunidad" />
    </div>
  </section>
</Base>

<style>
  .encabezado { max-width: 760px; margin-bottom: 2.5rem; }
  .citas { display: grid; gap: 2.5rem; }
  @media (min-width: 900px) { .citas { grid-template-columns: repeat(3, 1fr); } }
  .citas figure { margin: 0; padding-top: 1.25rem; border-top: 3px solid var(--verde); display: flex; flex-direction: column; }
  .citas blockquote { margin: 0 0 1.25rem; }
  .citas blockquote p { font-family: var(--font-cita); font-style: italic; font-size: 1.25rem; line-height: 1.5; color: var(--azul-noche); }
  .citas figcaption { display: grid; margin-top: auto; }
  .citas figcaption strong { color: var(--azul); }
  .citas figcaption span { font-size: 0.95rem; color: var(--texto-suave); }
  .comparte { margin-top: 3rem; color: var(--texto-suave); }
  .franja { padding-block: clamp(5rem, 4rem + 5vw, 9rem); }
  .franja::before { background: linear-gradient(100deg, rgb(0 74 151 / 0.92), rgb(0 74 151 / 0.6) 60%, rgb(0 148 130 / 0.35)); }
  .franja h2 { max-width: 18ch; }
  .franja p { max-width: 52ch; font-size: 1.2rem; color: rgb(255 255 255 / 0.9); margin-bottom: 2rem; }
</style>
