---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Icono from '../components/Icono.astro';

import fotoBanderas from '../assets/fotos/banderas.jpg';
import fotoDilijan from '../assets/fotos/campus-dilijan.jpg';
import fotoWaterford from '../assets/fotos/campus-waterford.jpg';

const pilares = [
  { icono: 'mundo', titulo: 'Un movimiento global', texto: '18 colegios en cuatro continentes, cada uno con su propio carácter, dedicados a convertir la energía de los jóvenes en empatía y acción.' },
  { icono: 'personas', titulo: 'Intencionalmente diversos', texto: 'Comités nacionales en más de 150 países permiten reunir a jóvenes de todos los orígenes, culturas y experiencias de vida.' },
  { icono: 'escudo', titulo: 'Selectivos, no exclusivos', texto: 'Más del 80% de los estudiantes seleccionados por comités nacionales reciben apoyo financiero total o parcial.' },
  { icono: 'corazon', titulo: 'Servicio tanto como conocimiento', texto: 'El IB se combina con servicio comunitario, liderazgo, creatividad y actividad física.' },
  { icono: 'estrella', titulo: 'Una comunidad de referentes', texto: 'Casi 60,000 exalumnos en todo el mundo que llevan la filosofía UWC a su trabajo y a sus comunidades.' },
] as const;

const colegios = [
  ['UWC Atlantic', 'Gales, Reino Unido', 1962],
  ['Pearson College UWC', 'Canadá', 1974],
  ['UWC South East Asia', 'Singapur', 1975],
  ['UWC Waterford Kamhlaba', 'Esuatini', 1981],
  ['UWC Adriatic', 'Italia', 1982],
  ['UWC USA', 'Estados Unidos', 1982],
  ['Li Po Chun UWC', 'Hong Kong', 1992],
  ['UWC Red Cross Nordic', 'Noruega', 1995],
  ['UWC Mahindra College', 'India', 1997],
  ['UWC Costa Rica', 'Costa Rica', 2006],
  ['UWC Mostar', 'Bosnia y Herzegovina', 2006],
  ['UWC Maastricht', 'Países Bajos', 2009],
  ['UWC Robert Bosch College', 'Alemania', 2014],
  ['UWC Dilijan', 'Armenia', 2014],
  ['UWC Changshu China', 'China', 2015],
  ['UWC Thailand', 'Tailandia', 2016],
  ['UWC ISAK Japan', 'Japón', 2017],
  ['UWC East Africa', 'Tanzania', 2019],
] as const;
---

<Base
  titulo="Descubre UWC"
  descripcion="Qué son los Colegios del Mundo Unido (UWC): misión, modelo educativo, Bachillerato Internacional y los 18 colegios en cuatro continentes."
>
  <CabeceraPagina
    antetitulo="Descubre UWC"
    titulo="Una escuela donde tus compañeros vienen de todo el mundo"
    entrada="Imagina estudiar con jóvenes que hablan otros idiomas, practican otras religiones y vienen de realidades muy distintas a la tuya. Donde cada día trae un reto personal, además del académico. Eso es un Colegio del Mundo Unido."
    imagen={fotoBanderas}
    alt="Estudiantes UWC de decenas de países con las banderas de sus naciones"
  />

  <section class="seccion seccion--oscura mision">
    <div class="contenedor">
      <p class="antetitulo">Nuestra misión</p>
      <blockquote>
        <p>“Hacer de la educación una fuerza para unir a las personas, las naciones y las culturas por la paz y un futuro sostenible.”</p>
      </blockquote>
    </div>
  </section>

  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <p class="antetitulo">Qué nos hace distintos</p>
        <h2>Valores que se viven, no solo se enseñan</h2>
      </div>
      <div class="grid grid--3">
        {
          pilares.map((p, i) => (
            <div class="tarjeta revelar" style={`--retraso:${(i % 3) * 80}ms`}>
              <span class="icono-circulo"><Icono nombre={p.icono} /></span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="educacion" class="seccion">
    <div class="contenedor educacion">
      <div class="educacion__fotos">
        <div class="revelar"><Image src={fotoDilijan} alt="Campus de UWC Dilijan, en Armenia, rodeado de montañas" widths={[480, 800]} sizes="(min-width: 1000px) 540px, 92vw" /></div>
        <div class="revelar" style="--retraso:120ms"><Image src={fotoWaterford} alt="Campus de UWC Waterford Kamhlaba en Esuatini" widths={[400, 640]} sizes="(min-width: 1000px) 320px, 60vw" /></div>
      </div>
      <div>
        <p class="antetitulo">Educación UWC</p>
        <h2>El Bachillerato Internacional, y mucho más</h2>
        <p class="entrada">
          En los colegios se cursa el Diploma del Bachillerato Internacional (IB), reconocido por la SEP, la UNAM y universidades de
          todo el mundo. Pero el aprendizaje va más allá del salón.
        </p>
        <ul class="principios">
          <li><Icono nombre="check" tam={18} />Un ambiente diverso para entender y respetar otras culturas.</li>
          <li><Icono nombre="check" tam={18} />Proyectos de servicio social en la comunidad que rodea al colegio.</li>
          <li><Icono nombre="check" tam={18} />Vida en comunidad: todos participan y todos son responsables.</li>
          <li><Icono nombre="check" tam={18} />Acciones concretas por la sustentabilidad.</li>
          <li><Icono nombre="check" tam={18} />Iniciativa personal, autodisciplina y aprender a enfrentar retos.</li>
        </ul>
        <p>Las clases y la vida diaria son en inglés, sin importar en qué país esté el colegio.</p>
      </div>
    </div>
  </section>

  <section id="colegios" class="seccion seccion--blanca">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <p class="antetitulo">Los colegios</p>
        <h2>18 colegios en cuatro continentes</h2>
        <p class="entrada">UWC México asigna a cada persona seleccionada un colegio según sus preferencias y los lugares disponibles cada año.</p>
      </div>
      <ul class="colegios">
        {
          colegios.map(([nombre, pais, anio]) => (
            <li>
              <span class="colegios__nombre">{nombre}</span>
              <span class="colegios__pais">
                <Icono nombre="ubicacion" tam={15} />
                {pais} · desde {anio}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="fuente">Más información sobre cada colegio en <a href="https://www.uwc.org/" rel="noopener">uwc.org</a>.</p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor cierre">
      <h2>¿Te imaginas ahí?</h2>
      <div class="botones">
        <a href="/aplica/" class="boton boton--primario">Conoce cómo aplicar <Icono nombre="flecha" tam={18} /></a>
        <a href="/comunidad/" class="boton boton--contorno">Conoce a nuestros graduados</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .mision { text-align: center; padding-block: var(--space-6); }
  .mision .antetitulo::before { display: none; }
  .mision blockquote { margin: 0 auto; max-width: 900px; }
  .mision blockquote p {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.6rem);
    line-height: 1.3;
    font-style: italic;
    margin: 0;
  }

  .educacion { display: grid; gap: var(--space-5); align-items: center; }
  @media (min-width: 1000px) { .educacion { grid-template-columns: 1fr 1fr; gap: var(--space-6); } }
  .educacion__fotos { position: relative; padding-bottom: 18%; }
  .educacion__fotos > div { border-radius: var(--radio); overflow: hidden; box-shadow: var(--sombra-alta); }
  .educacion__fotos > div:first-child { aspect-ratio: 16/10; }
  .educacion__fotos > div:last-child {
    position: absolute;
    width: 55%;
    right: -4%;
    bottom: 0;
    aspect-ratio: 4/3;
    border: 6px solid var(--papel);
  }
  .educacion__fotos img { width: 100%; height: 100%; object-fit: cover; }
  .principios { list-style: none; padding: 0; margin: var(--space-3) 0; display: grid; gap: 0.7rem; }
  .principios li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .principios svg { flex-shrink: 0; margin-top: 4px; color: var(--verde-texto); }

  .colegios {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 640px) { .colegios { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .colegios { grid-template-columns: repeat(3, 1fr); } }
  .colegios li {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.2rem;
    border-radius: var(--radio-sm);
    background: var(--papel);
    border: 1px solid var(--linea);
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .colegios li:hover { border-color: var(--verde); background: var(--verde-claro); }
  .colegios__nombre { font-weight: 700; color: var(--azul-profundo); }
  .colegios__pais { display: inline-flex; align-items: center; gap: 0.35rem; font-size: var(--text-sm); color: var(--tinta-suave); }
  .fuente { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--tinta-suave); }

  .cierre { text-align: center; display: grid; justify-items: center; }
  .cierre .botones { justify-content: center; }
</style>
