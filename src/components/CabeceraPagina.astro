---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  antetitulo: string;
  titulo: string;
  entrada: string;
  imagen?: ImageMetadata;
  alt?: string;
}
const { antetitulo, titulo, entrada, imagen, alt = '' } = Astro.props;
---

<section class:list={['cabecera', { 'cabecera--imagen': imagen }]}>
  <div class="contenedor cabecera__grid">
    <div class="cabecera__texto">
      <p class="antetitulo">{antetitulo}</p>
      <h1>{titulo}</h1>
      <p class="entrada">{entrada}</p>
      <slot />
    </div>
    {
      imagen && (
        <div class="cabecera__foto">
          <Image
            src={imagen}
            alt={alt}
            widths={[480, 720, 1000]}
            sizes="(min-width: 1000px) 520px, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .cabecera {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-5) var(--space-6);
  }
  .cabecera::after {
    content: '';
    position: absolute;
    right: -140px;
    top: -180px;
    width: 460px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 44px solid var(--verde);
    opacity: 0.1;
    pointer-events: none;
  }
  .cabecera h1 { font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.6rem); }
  .cabecera__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .cabecera--imagen .cabecera__grid { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-6); }
  }
  .cabecera__texto .entrada { margin-bottom: var(--space-3); }
  .cabecera__foto {
    aspect-ratio: 4 / 3;
    border-radius: var(--radio) var(--radio) var(--radio) 120px;
    overflow: hidden;
    box-shadow: var(--sombra-alta);
  }
  .cabecera__foto img { width: 100%; height: 100%; object-fit: cover; }
</style>
