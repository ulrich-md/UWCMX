---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Icono from './Icono.astro';
import { foto } from '../lib/fotos';
import type { Seccion } from '../lib/secciones';

// Tarjetas con foto hacia cada página de una sección.
interface Props {
  seccion: Seccion;
  excluir?: string[];
}
const { seccion, excluir = [] } = Astro.props;
const paginas = (await getCollection('paginas'))
  .filter((p) => p.data.seccion === seccion && !excluir.includes(p.id.split('/')[1]))
  .sort((a, b) => a.data.orden - b.data.orden);
---

<ul class="tarjetas">
  {
    paginas.map((p, i) => (
      <li class="revelar" style={`--retraso:${(i % 3) * 90}ms`}>
        <a href={`/${p.id}/`} class="tarjeta">
          {p.data.imagen ? (
            <div class="tarjeta__img">
              <Image src={foto(p.data.imagen)} alt="" widths={[400, 640]} sizes="(min-width: 1000px) 380px, 92vw" />
            </div>
          ) : null}
          <div class="tarjeta__texto">
            <h3>{p.data.titulo}</h3>
            <p>{p.data.resumen}</p>
            <span class="enlace">
              Leer más <Icono nombre="flecha" tam={18} />
            </span>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tarjetas {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 700px) { .tarjetas { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .tarjetas { grid-template-columns: repeat(3, 1fr); } }
  .tarjeta {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--blanco);
    color: var(--texto);
    text-decoration: none;
    border-radius: var(--radio);
    overflow: hidden;
    border: 1px solid var(--gris-linea);
    border-top: 4px solid var(--azul);
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .tarjeta:hover { color: var(--texto); border-top-color: var(--verde); box-shadow: var(--sombra); }
  .tarjeta__img { aspect-ratio: 16 / 9; overflow: hidden; }
  .tarjeta__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .tarjeta:hover .tarjeta__img img { transform: scale(1.04); }
  .tarjeta__texto { display: flex; flex-direction: column; flex: 1; padding: 1.5rem; }
  .tarjeta h3 { color: var(--azul); margin-bottom: 0.5rem; }
  .tarjeta p { color: var(--texto-suave); font-size: 1rem; }
  .tarjeta .enlace { margin-top: auto; color: var(--azul); }
</style>
