---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icono from './Icono.astro';

interface Props {
  titulo: string;
  entrada?: string;
  imagen: ImageMetadata;
  alt?: string;
  migas?: { texto: string; href: string }[];
  alta?: boolean;
}
const { titulo, entrada, imagen, alt = '', migas = [], alta = false } = Astro.props;
---

<section class:list={['portada fondo-foto fondo-foto--degradado parallax', { 'portada--alta': alta }]}>
  <div class="fondo-foto__img">
    <Image src={imagen} alt={alt} widths={[640, 1024, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="contenedor portada__interior">
    {
      migas.length > 0 && (
        <nav aria-label="Ruta de navegación" class="migas">
          <ol>
            <li>
              <a href="/">Inicio</a>
            </li>
            {migas.map((m) => (
              <li>
                <Icono nombre="derecha" tam={14} />
                <a href={m.href}>{m.texto}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1>{titulo}</h1>
    {entrada && <p class="portada__entrada">{entrada}</p>}
    <slot />
  </div>
</section>

<style>
  .portada {
    display: flex;
    align-items: flex-end;
    min-height: clamp(360px, 52vh, 520px);
    padding-block: calc(var(--alto-header) + 3rem) clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .portada--alta { min-height: clamp(460px, 70vh, 680px); }
  .portada__interior { max-width: var(--ancho); }
  .portada h1 { max-width: 16ch; font-size: clamp(2.3rem, 1.5rem + 3.6vw, 4.25rem); margin-bottom: 0.35em; }
  .portada__entrada {
    max-width: 58ch;
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.35rem);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.92);
    margin-bottom: 1.5rem;
  }
  .migas ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .migas li { display: inline-flex; align-items: center; gap: 0.35rem; }
  .migas a { color: rgb(255 255 255 / 0.85); text-decoration: none; }
  .migas a:hover { color: var(--blanco); text-decoration: underline; }
  .migas :global(svg) { opacity: 0.6; }
</style>
