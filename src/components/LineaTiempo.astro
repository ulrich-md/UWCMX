---
import sitio from '../data/sitio.json';
import Icono from './Icono.astro';

interface Props {
  /** Texto claro sobre fondo oscuro o de foto. */
  claro?: boolean;
}
const { claro = false } = Astro.props;
const { etapas } = sitio;
const { estado, etapaActual } = sitio.convocatoria;
const actual = estado === 'cerrada' ? 0 : estado === 'abierta' ? 1 : etapaActual;
---

<ol class:list={['linea', { 'linea--clara': claro }]}>
  {
    etapas.map((etapa, i) => {
      const n = i + 1;
      const clase = n < actual ? 'hecha' : n === actual ? 'actual' : 'pendiente';
      return (
        <li class:list={['paso', `paso--${clase}`, 'revelar']} style={`--retraso:${i * 100}ms`}>
          <span class="paso__marca" aria-hidden="true">
            {n < actual ? <Icono nombre="check" tam={18} /> : n}
          </span>
          <p class="paso__periodo">{etapa.periodo}</p>
          <h3>
            {etapa.nombre}
            {n === actual && <span class="paso__ahora">En curso</span>}
          </h3>
          <p class="paso__desc">{etapa.descripcion}</p>
        </li>
      );
    })
  }
</ol>

<style>
  .linea {
    --c-texto: var(--texto);
    --c-suave: var(--texto-suave);
    --c-linea: var(--gris-linea);
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .linea--clara {
    --c-texto: var(--blanco);
    --c-suave: rgb(255 255 255 / 0.82);
    --c-linea: rgb(255 255 255 / 0.3);
  }
  @media (min-width: 960px) {
    .linea { grid-template-columns: repeat(5, 1fr); gap: 1.5rem; position: relative; }
    .linea::before {
      content: '';
      position: absolute;
      top: 21px;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--c-linea);
    }
  }
  .paso { position: relative; color: var(--c-texto); }
  @media (max-width: 959px) {
    .paso { padding-left: 64px; }
    .paso__marca { position: absolute; left: 0; top: 0; }
  }
  .paso__marca {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 1rem;
    border-radius: 50%;
    font-weight: 700;
    font-size: 1.1rem;
    background: var(--blanco);
    color: var(--azul);
    border: 2px solid var(--c-linea);
  }
  .paso--hecha .paso__marca { background: var(--verde); border-color: var(--verde); color: var(--blanco); }
  .paso--actual .paso__marca { background: #ffb400; border-color: #ffb400; color: var(--azul-noche); box-shadow: 0 0 0 6px rgb(255 180 0 / 0.25); }
  .paso__periodo { margin: 0 0 0.2rem; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-suave); }
  .paso h3 { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 1.3rem; margin: 0 0 0.4rem; color: var(--c-texto); }
  .paso__ahora { font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 3px; background: #ffb400; color: var(--azul-noche); letter-spacing: 0.02em; }
  .paso__desc { margin: 0; font-size: 0.975rem; color: var(--c-suave); }
</style>
