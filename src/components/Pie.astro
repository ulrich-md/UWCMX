---
import Icono from './Icono.astro';
import sitio from '../data/sitio.json';
import { menuCompleto } from '../lib/secciones';

const menu = await menuCompleto();
---

<footer class="pie">
  <div class="pie__cta">
    <div class="contenedor pie__cta-interior">
      <p>¿Tienes dudas sobre el proceso de selección o quieres apoyar?</p>
      <div class="botones">
        <a href={`mailto:${sitio.contacto.correo}`} class="boton boton--contorno-blanco"><Icono nombre="correo" tam={18} />Escríbenos</a>
        <a href="/apoya/como-donar/" class="boton boton--donar"><Icono nombre="corazon" tam={18} />Dona</a>
      </div>
    </div>
  </div>

  <div class="contenedor pie__columnas">
    <div class="pie__marca">
      <p class="pie__logo">
        <img src="/uwc.svg" alt="" width="150" height="34" />
        <span>México</span>
      </p>
      <p>
        <strong>Nuestra misión:</strong> hacer de la educación una fuerza para unir a las personas, las naciones y las culturas por
        la paz y un futuro sostenible.
      </p>
      <p class="pie__datos">
        Asociación Mexicana pro Colegios del Mundo Unido, A.C.<br />
        {sitio.contacto.direccion}<br />
        {sitio.contacto.horario}<br />
        <a href={`mailto:${sitio.contacto.correo}`}>{sitio.contacto.correo}</a>
      </p>
      <ul class="pie__redes" aria-label="Redes sociales">
        <li><a href={sitio.redes.instagram} aria-label="Instagram de UWC México"><Icono nombre="instagram" tam={20} /></a></li>
        <li><a href={sitio.redes.facebook} aria-label="Facebook de UWC México"><Icono nombre="facebook" tam={20} /></a></li>
        <li><a href={sitio.redes.youtube} aria-label="YouTube de UWC México"><Icono nombre="youtube" tam={20} /></a></li>
      </ul>
    </div>

    {
      menu.map((s) => (
        <nav aria-label={s.titulo} class="pie__nav">
          <h2>
            <a href={s.href}>{s.titulo}</a>
          </h2>
          <ul>
            {s.enlaces.slice(0, 8).map((e) => (
              <li>
                <a href={e.href}>{e.texto}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="contenedor pie__legal">
    <p>© {new Date().getFullYear()} UWC México · Donataria autorizada</p>
    <ul>
      <li><a href="/nosotros/aviso-de-privacidad/">Aviso de privacidad</a></li>
      <li><a href="/nosotros/proteccion-participantes/">Protección de participantes</a></li>
      <li><a href="https://www.uwc.org/" rel="noopener">UWC International</a></li>
    </ul>
  </div>
</footer>

<style>
  .pie {
    background: var(--azul-noche);
    color: rgb(255 255 255 / 0.75);
    font-size: 0.95rem;
  }
  .pie a { color: rgb(255 255 255 / 0.85); text-decoration: none; }
  .pie a:hover { color: var(--blanco); text-decoration: underline; }

  .pie__cta { background: var(--degradado); color: var(--blanco); }
  .pie__cta-interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-block: 2.25rem;
  }
  .pie__cta p { margin: 0; font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem); font-weight: 700; }
  .pie__cta .boton--contorno-blanco { color: var(--blanco); }
  .pie__cta .boton--contorno-blanco:hover { color: var(--azul); text-decoration: none; }
  .pie__cta .boton--donar:hover { text-decoration: none; }

  .pie__columnas {
    display: grid;
    gap: 2.5rem 2rem;
    padding-block: 4rem 3rem;
    grid-template-columns: repeat(2, 1fr);
  }
  .pie__marca { grid-column: 1 / -1; }
  @media (min-width: 1000px) {
    .pie__columnas { grid-template-columns: 1.7fr repeat(5, 1fr); }
    .pie__marca { grid-column: auto; }
  }
  .pie__logo { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.2rem; }
  .pie__logo img { width: 140px; filter: brightness(0) invert(1); }
  .pie__logo span {
    padding-left: 0.6rem;
    border-left: 2px solid rgb(255 255 255 / 0.3);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7fd6c9;
  }
  .pie__marca > p { max-width: 36ch; }
  .pie__datos { line-height: 1.8; }
  .pie__redes { display: flex; gap: 0.6rem; list-style: none; margin: 1.2rem 0 0; padding: 0; }
  .pie__redes a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    transition: background-color 0.2s;
  }
  .pie__redes a:hover { background: var(--verde); }

  .pie__nav h2 { font-size: 1rem; margin-bottom: 0.9rem; letter-spacing: 0; }
  .pie__nav h2 a { color: var(--blanco); }
  .pie__nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }

  .pie__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.875rem;
  }
  .pie__legal p { margin: 0; }
  .pie__legal ul { display: flex; flex-wrap: wrap; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
</style>
